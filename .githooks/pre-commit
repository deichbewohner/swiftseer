#!/usr/bin/env bash
set -euo pipefail

# Format only staged Go files and re-stage them
changed=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.go$' || true)
if [ -z "$changed" ]; then
  exit 0
fi

echo "Running gofmt on staged Go files..."
while IFS= read -r f; do
  [ -f "$f" ] || continue
  gofmt -w "$f"
  git add "$f"
done <<< "$changed"

exit 0

